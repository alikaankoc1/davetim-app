# Supabase — kendi değerlerini .env.local dosyasına yaz
# Bu dosya örnek; GitHub'a gidebilir. Gerçek key'leri asla commit etme.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Canlı site adresi (WhatsApp paylaşımı için). Örn: https://davetim.com
# NEXT_PUBLIC_SITE_URL=https://davetim.com

# Sadece sunucu (API route / webhook). NEXT_PUBLIC_ yapma!
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here
